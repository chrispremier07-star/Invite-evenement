# Stockage utilisé par les tests : MinIO local (docker compose), jamais le bucket de production.
# Chargé AVANT .env : une variable déjà définie n'est pas écrasée.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=cree-uploads
S3_ACCESS_KEY_ID=cree_minio_user
S3_SECRET_ACCESS_KEY=cree_minio_password
S3_FORCE_PATH_STYLE=true
