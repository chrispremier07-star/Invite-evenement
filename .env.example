# Copiez ce fichier en .env puis adaptez chaque valeur. Aucune variable ne possède de valeur par défaut
# dans le code : l'API refuse de démarrer si l'une d'elles manque (sauf SENTRY_DSN, facultative).
# Les valeurs ci-dessous fonctionnent pour le développement local avec `docker compose up -d`.

# --- Serveur ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
LOG_LEVEL=info
# true derrière un proxy HTTPS (Fly, Render, Railway, Nginx) pour lire la vraie IP du visiteur
TRUST_PROXY=false
# Adresse publique de l'API (en production : https obligatoire)
PUBLIC_URL=http://localhost:3100
# Adresse du Studio (celle du lien de connexion envoyé par e-mail)
STUDIO_URL=http://localhost:5174/studio/
# Origines autorisées à appeler l'API depuis un navigateur (formulaire et Studio), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3100
# Dossiers des fronts compilés servis par l'API (formulaire à la racine, Studio sous /studio/)
FORM_DIST_DIR=apps/form/dist
STUDIO_DIST_DIR=apps/studio/dist

# --- Base de données (docker compose) ---------------------------------------
POSTGRES_USER=cree
POSTGRES_PASSWORD=cree_dev_password
POSTGRES_DB=cree
POSTGRES_PORT=54340
DATABASE_URL=postgres://cree:cree_dev_password@localhost:54340/cree
# Base jetable utilisée par les tests d'intégration (créée automatiquement)
TEST_DATABASE_URL=postgres://cree:cree_dev_password@localhost:54340/cree_test

# --- Secrets (générez les vôtres : openssl rand -base64url 48) ---
SESSION_SECRET=remplacez-moi-par-48-octets-aleatoires-en-base64url-0000
IP_HASH_SECRET=remplacez-moi-par-48-octets-aleatoires-en-base64url-1111
SESSION_DAYS=30
LOGIN_LINK_MINUTES=15
# Délai minimal entre deux liens de connexion demandés pour le même compte
LOGIN_LINK_COOLDOWN_SECONDS=60

# --- Créateur et valeurs initiales des réglages (modifiables ensuite dans le Studio) ---
ADMIN_EMAIL=createur@example.org
DEFAULT_RESPONSE_DELAY_HOURS=48
DEFAULT_RETENTION_DAYS=730
PURGE_DELAY_DAYS=30

# --- RGPD (affichés sur la page de confidentialité) -------------------------
PRIVACY_CONTROLLER_NAME=Crée
PRIVACY_CONTACT_EMAIL=confidentialite@example.org
POLICY_VERSION=2026-11

# --- Notifications push (npm run vapid) ------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:createur@example.org

# --- E-mail transactionnel : SMTP (Resend, Postmark, Brevo… ou Mailpit en local) ---
SMTP_URL=smtp://localhost:1125
MAIL_FROM="Crée <contact@example.org>"
MAILPIT_PORT=8125
MAILPIT_SMTP_PORT=1125

# --- Stockage de fichiers compatible S3 (MinIO en local, R2/S3/Scaleway en production) ---
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=cree-uploads
S3_ACCESS_KEY_ID=cree_minio_user
S3_SECRET_ACCESS_KEY=cree_minio_password
S3_FORCE_PATH_STYLE=true
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# --- Anti-robot Cloudflare Turnstile (clés de test officielles : acceptent toujours) ---
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SCRIPT_URL=https://challenges.cloudflare.com/turnstile/v0/api.js
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# --- Limitation de débit (requêtes par fenêtre et par IP) -------------------
RATE_GLOBAL_PER_MINUTE=300
RATE_SUBMIT_PER_HOUR=10
RATE_UPLOAD_PER_HOUR=60
RATE_AUTH_PER_HOUR=10

# --- Supervision (facultatif) ----------------------------------------------
SENTRY_DSN=

# --- Cloudflare : valeurs de PRODUCTION (décommentez et remplacez les lignes actives ci-dessus) ---
# R2 (stockage, API compatible S3) : dashboard.cloudflare.com > R2 > créer le bucket (privé) > Gérer les jetons API R2 > Créer un jeton (Lecture et écriture, limité au bucket)
# S3_ENDPOINT=https://<ID_DE_COMPTE>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=<nom_du_bucket>
# S3_ACCESS_KEY_ID=<identifiant_de_clé_d_accès>
# S3_SECRET_ACCESS_KEY=<clé_d_accès_secrète>
# S3_FORCE_PATH_STYLE=false
# Turnstile (anti-robot) : dashboard.cloudflare.com > Turnstile > Add widget (domaine du site, mode Managed)
# TURNSTILE_SITE_KEY=<clé_de_site>
# TURNSTILE_SECRET_KEY=<clé_secrète>
# Le CORS du bucket R2 doit autoriser POST depuis PUBLIC_URL (R2 > bucket > Paramètres > Stratégie CORS).
